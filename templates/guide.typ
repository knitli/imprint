//
// Imprint PDF rendition of an OpenSCG guide (decision 0005, spike SP-04).
// Compiled with --pdf-standard ua-1, so Typst refuses to build a PDF that
// breaks the accessibility rules it knows about, and tags the document.
//
// All guide text comes from model.json and is inserted as plain text: Typst
// does not interpret markup inside strings, so guide content cannot change
// the layout or run anything.

#let m = json(sys.inputs.at("model", default: "model.json"))

// Long identifiers (digests, URNs) have no natural break points. Allow a line
// break between any two characters so they wrap instead of running off the page.
#let breakable(s) = s.clusters().join(sym.zws)
#let mono(s) = text(font: "DejaVu Sans Mono", size: 7.5pt, breakable(s))
#let label = (if m.synthetic { "SYNTHETIC · " } else { "" }) + m.statusLabel

#set document(title: m.title, author: "Imprint")
#set text(lang: "en", font: "Libertinus Serif", size: 10.5pt, hyphenate: false)
#set par(justify: false)
#set page(
  paper: "us-letter",
  margin: (top: 2.6cm, bottom: 2.8cm, x: 2cm),
  header: align(center, text(weight: "bold", m.banner)),
  footer: context [
    #align(center, text(weight: "bold", m.banner))
    #v(-0.5em)
    #set text(size: 7pt)
    #align(center)[#label · revision #m.revisionId · page #counter(page).display() of #counter(page).final().first()]
    #v(-0.6em)
    #align(center)[#breakable(m.guideId) · #m.digest.alg:#breakable(m.digest.value)]
  ],
  background: rotate(-35deg, text(size: 54pt, fill: rgb(200, 0, 0, 45), weight: "bold", m.watermark)),
)

#block(stroke: 1.5pt + rgb(180, 0, 0), inset: 8pt, width: 100%)[
  *#label.* #if m.status == "draft" [This is a draft, not an issued guide.] else [This revision is frozen: its content will not change. This file does not show whether it was approved. Approval is recorded in a separate signed attestation; check it with Imprint or another OpenSCG verifier.]
  #if m.synthetic [ This guide is marked as invented; it is not real classification guidance.]
]

// Running headers and footers are page artifacts, which screen readers skip.
// State the overall marking once in the body so it is read aloud.
*Overall classification of this document: #m.banner*

= #m.title

#table(
  columns: (auto, 1fr),
  stroke: 0.4pt,
  table.header([*Field*], [*Value*]),
  [Guide ID], mono(m.guideId),
  [Revision], [#m.revisionId],
  [Payload digest], mono(m.digest.alg + ":" + m.digest.value),
  ..m.facts.map(f => ([#f.label], [#f.value])).flatten(),
)

#if m.authorityBlock.len() > 0 [
  == Classification authority block of this document
  #table(
    columns: (auto, 1fr),
    stroke: 0.4pt,
    ..m.authorityBlock.map(f => ([#f.label], [#f.value])).flatten(),
  )
]

#if m.introduction != "" [
  == Introduction
  #m.introduction
]

#if m.openFindings.len() > 0 [
  == Open review items
  #list(..m.openFindings.map(f => [#f]))
]

#for g in m.groups [
  == #if g.portion != "" [#g.portion ] #g.title
  #if g.description != "" [#g.description]
  #if g.entries.len() == 0 [_No entries in this section._] else [
    #table(
      // Fixed widths: an `auto` column grows to fit its longest cell and can
      // push later columns off the page (SP-04 finding).
      columns: (4.6em, 2fr, 4.2em, 1.4fr, 1.4fr),
      stroke: 0.4pt,
      table.header([*Portion*], [*Information*], [*Level*], [*Reason*], [*Declassification*]),
      ..g.entries.map(e => (
        [#e.portion],
        [
          #text(size: 8pt, fill: rgb(80, 80, 80), e.id + if e.kind == "compilation" [ (compilation)] else [])\
          #e.description
          #if e.levelConditions != "" [\ _Level depends on:_ #e.levelConditions]
          #if e.condition != "" [\ _Conditions:_ #e.condition]
          #if e.references != "" [\ _Related entries:_ #e.references]
          #if e.exceptions != "" [\ _Exceptions:_ #e.exceptions]
          #if e.controls != "" [\ _Controls:_ #e.controls]
          #if e.regime != "" [\ _Regime:_ #e.regime]
          #if e.sources != "" [\ _Sources:_ #e.sources]
          #if e.statements != "" [\ _Statements:_ #e.statements]
          #if e.notes != "" [\ _Notes:_ #e.notes]
        ],
        [#e.level],
        [#if e.reason == "" [Not required] else [#e.reason]],
        [#if e.declassification == "" [Not applicable] else [#e.declassification]],
      )).flatten()
    )
  ]
]

== About this document
This PDF was generated by Imprint from OpenSCG #m.openscg data. The OpenSCG JSON file is the authoritative copy. The payload digest identifies that JSON; it does not by itself prove that this PDF matches it. To check this PDF, compare its SHA-256 hash with the release manifest that accompanies it.
